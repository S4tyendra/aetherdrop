---
import Base from "../layouts/Base.astro";
import { Logo, SiteFooter } from "../components/Brand.tsx";
---

<Base title="Page not found | Tincan" description="This page doesn't exist. Open Tincan to start a private room for two." noindex>
  <div class="flex min-h-dvh flex-col">
    <header class="border-b border-line bg-deep">
      <div class="mx-auto flex h-14 max-w-[1440px] items-center px-4 md:px-8"><Logo /></div>
    </header>
    <main class="mx-auto flex w-full max-w-[1440px] flex-1 flex-col items-start justify-center px-4 py-16 md:px-8">
      <p class="font-mono text-sm text-fg-3">404</p>
      <h1 class="mt-2 text-3xl font-medium tracking-tight text-fg">Nothing on the other end of this line</h1>
      <p class="mt-3 text-base text-fg-2">The page you asked for doesn't exist. Rooms live at links like <code class="font-mono text-fg">/room/?r=ABCDE</code></p>
      <a href="/" class="mt-8 flex h-10 items-center rounded-[10px] bg-fg px-4 text-sm font-medium text-page hover:bg-white">Back to rooms</a>
    </main>
    <SiteFooter />
  </div>
</Base>
