---
// Static, crawlable content under the lobby. Rendered at build time, no JavaScript.
import { FileUp, Gamepad2, Lock, MessageSquare, MonitorUp, Video } from "lucide-react";
import { FAQ } from "../lib/seo";

const icon = { size: 18, strokeWidth: 1.5, className: "text-fg-3" };

const features = [
  { Icon: Video, title: "Video and voice calls", text: "Camera and microphone go straight to the other browser. Pick 360p, 720p or 1080p to suit your connection." },
  { Icon: MonitorUp, title: "Screen sharing with sound", text: "Share a tab, a window or the whole screen, audio included. Choose sharp text for documents or smooth motion for video." },
  { Icon: MessageSquare, title: "Chat", text: "Messages travel over the same direct link as the call and disappear when you close the tab." },
  { Icon: FileUp, title: "Files of any size", text: "Drop a file and it streams to the other side, with error correction rebuilding lost pieces on the fly." },
  { Icon: Gamepad2, title: "Four games", text: "Tic-tac-toe, Three pieces, Connect four and Quoridor. Both browsers check every move." },
  { Icon: Lock, title: "Rooms with a PIN", text: "Add a 4 to 8 digit PIN so only people who know it can join. Empty rooms close after 10 minutes." },
];

const steps = [
  { title: "Create a room", text: "Give it a name and add a PIN if you like. It shows up in the list of open rooms." },
  { title: "Send the link", text: "The other person opens it in any current browser and joins. Rooms hold two people." },
  { title: "Talk directly", text: "Once you are both in, everything flows between your two browsers. Our server only made the introduction." },
];
---

<div class="mt-16 flex flex-col gap-16 md:mt-24 md:gap-24">
  <section aria-labelledby="features">
    <h2 id="features" class="text-2xl font-medium tracking-tight text-fg">Everything in one room</h2>
    <p class="mt-2 max-w-2xl text-base leading-6 text-fg-2">
      A Tincan room is a private space for two people. Talk, show your screen, pass files and play a round while you wait,
      without switching apps.
    </p>
    <ul class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map(({ Icon, title, text }) => (
          <li class="bg-card p-6">
            <Icon {...icon} />
            <h3 class="mt-4 text-[15px] font-medium text-fg">{title}</h3>
            <p class="mt-1 text-sm leading-5 text-fg-2">{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="how" class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <div>
      <h2 id="how" class="text-2xl font-medium tracking-tight text-fg">How it works</h2>
      <ol class="mt-8 flex flex-col gap-6">
        {
          steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-7 shrink-0 items-center justify-center rounded-md border border-line bg-raised font-mono text-sm text-fg tabular">
                {i + 1}
              </span>
              <div>
                <h3 class="text-[15px] font-medium text-fg">{s.title}</h3>
                <p class="mt-1 text-sm leading-5 text-fg-2">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-sm leading-5 text-fg-3">
        Want the details? <a href="/about/" class="text-fg-2 underline decoration-line-2 underline-offset-4 hover:text-fg">Read how Tincan works</a>
      </p>
    </div>
    <figure class="overflow-hidden rounded-2xl border border-line-2 bg-deep shadow-[0_24px_64px_rgba(0,0,0,0.45)]">
      <img
        src="/shots/room.jpg"
        width="1440"
        height="900"
        loading="lazy"
        decoding="async"
        alt="A Tincan room seen by one person: the other person's shared screen in the main view, a chat beside it and the games panel below"
        class="block h-auto w-full"
      />
      <figcaption class="border-t border-line px-4 py-3 text-xs text-fg-3">A room in use: Ana shares a page while she and Rohan chat</figcaption>
    </figure>
  </section>

  <section aria-labelledby="faq" class="max-w-3xl">
    <h2 id="faq" class="text-2xl font-medium tracking-tight text-fg">Common questions</h2>
    <div class="mt-6">
      {
        FAQ.map((f) => (
          <details class="group border-t border-line py-4 last:border-b">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] text-fg [&::-webkit-details-marker]:hidden">
              <h3 class="font-normal">{f.q}</h3>
              <span aria-hidden class="font-mono text-fg-3 transition-transform duration-150 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-fg-2">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</div>
